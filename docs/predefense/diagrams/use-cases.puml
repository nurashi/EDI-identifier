@startuml
left to right direction
skinparam monochrome true
actor "EDI analyst" as Analyst
actor Reviewer
rectangle "EDI Identifier" {
  usecase "Extract requirements\nfrom PDF" as Extract
  usecase "Verify source identity" as Verify
  usecase "Compare guides" as Compare
  usecase "Align requirements" as Align
  usecase "Review findings" as Review
  usecase "Inspect source evidence" as Evidence
  usecase "Export comparison JSON" as Export
  usecase "Save / export\nreview decisions" as Decisions
}
Analyst -- Extract
Analyst -- Compare
Analyst -- Export
Reviewer -- Review
Reviewer -- Decisions
Extract ..> Verify : <<include>>
Compare ..> Align : <<include>>
Review ..> Evidence : <<include>>
@enduml
